<Window x:Class="OpenNodeDesk.ImportConflictDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:OpenNodeDesk"
        Title="{DynamicResource {x:Static local:ImportConflictDialog.ResTitle}}"
        Height="240" Width="460" WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource AppBackground}" Foreground="{DynamicResource AppForeground}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TxtHint" TextWrapping="Wrap" VerticalAlignment="Top"/>

        <CheckBox x:Name="ChkApplyAll" Grid.Row="1"
                  Content="{DynamicResource {x:Static local:ImportConflictDialog.ResApplyAll}}"
                  Margin="0,12,0,0"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="{DynamicResource {x:Static local:ImportConflictDialog.ResSkip}}" Width="88" Height="30" Margin="0,0,8,0" Click="BtnSkip_Click"/>
            <Button Content="{DynamicResource {x:Static local:ImportConflictDialog.ResOverwrite}}" Width="88" Height="30" IsDefault="True" Click="BtnOverwrite_Click"/>
        </StackPanel>
    </Grid>
</Window>
