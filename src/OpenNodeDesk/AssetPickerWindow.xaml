<Window x:Class="OpenNodeDesk.AssetPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:OpenNodeDesk"
        Title="{DynamicResource {x:Static local:AssetPickerWindow.ResTitle}}"
        Width="540" Height="520" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackground}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid>
            <TextBox x:Name="TxtSearch" Style="{StaticResource ModernTextBoxStyle}" Height="32"
                     VerticalContentAlignment="Center" TextChanged="TxtSearch_TextChanged" KeyDown="TxtSearch_KeyDown"/>
            <TextBlock x:Name="TxtSearchHint" Text="{DynamicResource {x:Static local:AssetPickerWindow.ResSearchHint}}"
                       IsHitTestVisible="False" Margin="10,0" VerticalAlignment="Center"
                       Foreground="{DynamicResource MutedForeground}"/>
        </Grid>

        <Grid Grid.Row="1" Margin="0,10,0,0">
            <ListBox x:Name="LstAssets" Background="{DynamicResource SurfaceBackground}"
                     Foreground="{DynamicResource AppForeground}" BorderBrush="{DynamicResource BorderBrush}"
                     HorizontalContentAlignment="Stretch" MouseDoubleClick="LstAssets_MouseDoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="2,4">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource AppForeground}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <TextBlock Text="{Binding IpPortDisplay}" FontSize="11" Foreground="{DynamicResource MutedForeground}" Margin="0,0,10,0"/>
                                <TextBlock Text="{Binding Protocol}" FontSize="11" Foreground="{DynamicResource MutedForeground}" Margin="0,0,10,0"/>
                                <TextBlock Text="{Binding Group}" FontSize="11" Foreground="{DynamicResource MutedForeground}"/>
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="TxtEmpty" Text="{DynamicResource {x:Static local:AssetPickerWindow.ResNoMatch}}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{DynamicResource MutedForeground}" Visibility="Collapsed"/>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="BtnOpen" Content="{DynamicResource {x:Static local:AssetPickerWindow.ResOpen}}"
                    Width="90" Height="30" Style="{StaticResource PrimaryButtonStyle}" IsDefault="True"
                    Margin="0,0,8,0" Click="BtnOpen_Click"/>
            <Button Content="{DynamicResource {x:Static local:AssetPickerWindow.ResCancel}}"
                    Width="90" Height="30" Style="{StaticResource ModernButtonStyle}" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
