<Window x:Class="OpenNodeDesk.TemplatePickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:OpenNodeDesk"
        Title="{DynamicResource {x:Static local:TemplatePickerDialog.ResDlgTitle}}"
        Height="190" Width="460" WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource AppBackground}" Foreground="{DynamicResource AppForeground}">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{DynamicResource {x:Static local:TemplatePickerDialog.ResFldTemplate}}" VerticalAlignment="Center"/>
            <ComboBox x:Name="CmbTemplates" Grid.Column="1" Padding="4"/>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="{DynamicResource {x:Static local:TemplatePickerDialog.ResBtnOk}}" Width="80" Height="28" Margin="0,0,8,0" IsDefault="True" Click="BtnOk_Click"/>
            <Button Content="{DynamicResource {x:Static local:TemplatePickerDialog.ResBtnCancel}}" Width="80" Height="28" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
